#!/bin/sh
set -eu

prefix=/usr/local
exec_prefix='$(prefix)'
bindir='$(exec_prefix)/bin'

usage() {
    cat <<'HELP'
Usage: ./configure [OPTIONS]

Installation directories:
  --prefix=DIR        installation prefix (default: /usr/local)
  --exec-prefix=DIR   architecture-dependent prefix (default: PREFIX)
  --bindir=DIR        executable directory (default: EXEC_PREFIX/bin)
  --help              display this help

Then run: make && make install
HELP
}

for arg do
    case "$arg" in
        --prefix=*) prefix=${arg#*=} ;;
        --exec-prefix=*) exec_prefix=${arg#*=} ;;
        --bindir=*) bindir=${arg#*=} ;;
        --help|-h) usage; exit 0 ;;
        *) printf 'configure: unknown option: %s\n' "$arg" >&2; exit 1 ;;
    esac
done

case "$prefix" in
    /*) ;;
    *) echo 'configure: --prefix must be an absolute path' >&2; exit 1 ;;
esac

# Quote dollar signs for make, reject characters that would break make syntax.
for value in "$prefix" "$exec_prefix" "$bindir"; do
    case "$value" in
        *'\n'*|*'#'*|*'%'*) echo 'configure: unsupported character in directory' >&2; exit 1 ;;
    esac
done

cat > config.mk <<EOF2
# Generated by ./configure. Do not edit manually.
prefix := $prefix
exec_prefix = $exec_prefix
bindir = $bindir
EOF2
printf 'Configured Modulon:\n  prefix: %s\n  bindir: %s\nRun make, then make install.\n' "$prefix" "$bindir"
